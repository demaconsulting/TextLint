<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Build Configuration -->
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Code Quality Configuration -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
  </PropertyGroup>

  <!-- Implicit Usings -->
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- Test Framework Dependencies -->
  <ItemGroup>
    <!-- coverlet.MTP is coverlet's native Microsoft.Testing.Platform extension (the VSTest-only
         coverlet.collector no longer runs under the MTP 'dotnet test' mode required by xunit.v3 4.0.0).
         Child-element form configures both PrivateAssets and IncludeAssets:
         - PrivateAssets="all" keeps this test-coverage tool out of any consuming project's dependencies.
         - IncludeAssets lists all asset types (including 'build' and 'buildtransitive') to ensure the
           extension's MSBuild targets are activated so coverage is collected during test runs. -->
    <PackageReference Include="coverlet.MTP" Version="10.1.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>compile; runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" Version="2.5.2" />
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Code Analysis Dependencies -->
  <ItemGroup>
    <!-- Analyzer packages use child-element form to configure both PrivateAssets and IncludeAssets:
         - PrivateAssets="all" prevents these build-time analyzers from becoming transitive dependencies
           in any project that references this test project.
         - IncludeAssets lists all asset types (including 'analyzers' and 'buildtransitive') to ensure
           Roslyn analyzers and MSBuild targets are fully activated during the build. -->
    <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="10.0.403">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="SonarAnalyzer.CSharp" Version="10.35.0.4138">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Project References -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\DemaConsulting.TextLint\DemaConsulting.TextLint.csproj" />
  </ItemGroup>

  <!-- Test Data -->
  <ItemGroup>
    <!-- The word lists the embedded dictionaries are built from, copied beside the test assembly so the
         tests can check that every listed word is known (the repository layout is preserved under
         'dictionaries'). -->
    <Content Include="..\..\dictionaries\**\*.txt" Link="dictionaries\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />

    <!-- The routing script that defines which -ize endings the word lists treat as -ize forms; the tests read the
         pattern from it so they use exactly the production definition (it is not a word list and is not a .txt file). -->
    <Content Include="..\..\dictionaries\word_forms.py" Link="dictionaries\word_forms.py" CopyToOutputDirectory="PreserveNewest" />

    <!-- The cspell parity corpora, their settings, the recorded cspell output, and the list of deliberate
         differences, copied beside the test assembly (the folder layout is preserved under 'SpellChecking/Parity'). -->
    <Content Include="SpellChecking\Parity\corpus\*;SpellChecking\Parity\expected\*;SpellChecking\Parity\known-divergences.txt" CopyToOutputDirectory="PreserveNewest" />

    <!-- A resource that is not a valid dictionary, used to prove that a damaged embedded dictionary is
         reported by name. -->
    <EmbeddedResource Include="TestSupport\Resources\corrupt-dictionary.tld" LogicalName="DemaConsulting.TextLint.Tests.corrupt-dictionary.tld" />
  </ItemGroup>

</Project>
