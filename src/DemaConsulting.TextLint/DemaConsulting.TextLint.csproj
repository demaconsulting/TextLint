<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The library targets .NET 10 and .NET 11; the tool and the dictionary builder stay on net10.0. -->
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- NuGet Package Configuration -->
    <PackageId>DemaConsulting.TextLint</PackageId>
    <Version>0.0.0</Version>
    <Authors>DEMA Consulting</Authors>
    <Company>DEMA Consulting</Company>
    <Description>DEMA Consulting TextLint library for fast linting of code and documentation</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/demaconsulting/TextLint</PackageProjectUrl>
    <RepositoryUrl>https://github.com/demaconsulting/TextLint</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>Icon.png</PackageIcon>
    <PackageTags>textlint;linter;dotnet-library</PackageTags>
    <Copyright>Copyright DEMA Consulting</Copyright>
    <Title>TextLint</Title>
    <Product>DemaConsulting.TextLint</Product>

    <!-- Trim and Native AOT Compatibility: the tool is planned to be published as a Native AOT
         executable, so the library must stay trim and AOT safe. IsAotCompatible enables the trim,
         AOT, and single-file
         analyzers, which TreatWarningsAsErrors below turns into build failures. -->
    <IsAotCompatible>true</IsAotCompatible>

    <!-- Symbol Package Configuration -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- Code Quality Configuration -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>

    <!-- SBOM Configuration -->
    <GenerateSBOM>true</GenerateSBOM>
    <SBOMPackageName>$(PackageId)</SBOMPackageName>
    <SBOMPackageVersion>$(Version)</SBOMPackageVersion>
    <SBOMPackageSupplier>Organization: $(Company)</SBOMPackageSupplier>
  </PropertyGroup>

  <!-- Runtime Dependencies (flow to consumers of the package): YamlDotNet parses the .textlint.yaml
       settings file and Microsoft.Extensions.FileSystemGlobbing matches glob patterns against the
       file system. Both are trim and AOT clean when used as the library uses them. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.FileSystemGlobbing" Version="10.0.14" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

  <!-- Build Tool Dependencies -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Sbom.Targets" Version="4.1.13" PrivateAssets="All" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.403" PrivateAssets="All" />
  </ItemGroup>

  <!-- Code Analysis Dependencies -->
  <ItemGroup>
    <!-- Analyzer packages use child-element form to configure both PrivateAssets and IncludeAssets:
         - PrivateAssets="all" prevents these build-time analyzers from becoming transitive dependencies
           in packages that consume this library.
         - IncludeAssets lists all asset types (including 'analyzers' and 'buildtransitive') to ensure
           Roslyn analyzers and MSBuild targets are fully activated during the build. -->
    <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="10.0.403">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="SonarAnalyzer.CSharp" Version="10.35.0.4138">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DemaConsulting.TextLint.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\Icon.png" Pack="true" PackagePath="\" />
    <!-- The word lists embedded in the assembly carry third-party license terms that require the
         notices to accompany every copy of the data, so the notices travel in the package. -->
    <None Include="..\..\third-party\THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- Embedded Dictionaries
       The English and technical dictionaries are stored in the assembly as four binary files that the
       build produces from the plain-text word lists under dictionaries/. Nothing binary is committed:
       the DictionaryBuilder program converts the lists on every build in which they (or the program)
       changed, and the results are embedded with stable logical names that the code loads by name.
       The unsafe-code option stays off: the library reads each resource into a managed array. -->
  <PropertyGroup>
    <!-- The folder that holds one sub-folder of word lists per dictionary. Folder paths are kept without a
         trailing separator because the builder is started through a command line, where a backslash before
         a closing quote would escape the quote. -->
    <DictionaryWordListRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../dictionaries'))</DictionaryWordListRoot>

    <!-- Where the converted files go. BaseIntermediateOutputPath is used because IntermediateOutputPath is
         not yet set while the project body is evaluated; the configuration and target framework keep
         concurrent builds of different flavors from writing the same files. -->
    <DictionaryOutputDir>$(MSBuildProjectDirectory)/$(BaseIntermediateOutputPath)dictionaries/$(Configuration)/$(TargetFramework)</DictionaryOutputDir>

    <!-- Run the builder with the same dotnet host that runs MSBuild (set by the SDK); fall back to the
         dotnet on the path for hosts that do not set it. -->
    <DictionaryDotNet>$(DOTNET_HOST_PATH)</DictionaryDotNet>
    <DictionaryDotNet Condition="'$(DictionaryDotNet)' == ''">dotnet</DictionaryDotNet>
  </PropertyGroup>

  <ItemGroup>
    <!-- The dictionary names are the single source of truth: the folder name under dictionaries/, the
         file name of the converted file, and the last part of the embedded resource name. The technical
         dictionary is combined from several kinds of list, and the two regional dictionaries supply the
         spelling variants that the combination removes from the general technical lists (see the
         DictionaryBuilder design for the variant rule). The reviewed exclusions list names words that
         must never be known in any dictionary; the builder removes them from every dictionary. -->
    <Dictionary Include="en-common;en-US;en-GB;technical" />
    <DictionaryVariant Include="en-US;en-GB" />

    <!-- Every word list is an input, so editing any list (including the exclusions list) triggers a conversion. -->
    <DictionaryWordList Include="$(DictionaryWordListRoot)/**/*.txt" />
    <DictionaryBinary Include="@(Dictionary->'$(DictionaryOutputDir)/%(Identity).tld')" />

    <!-- The converted files are embedded under stable logical names, independent of folder and namespace. -->
    <EmbeddedResource Include="@(DictionaryBinary)" LogicalName="DemaConsulting.TextLint.Dictionaries.%(Filename)%(Extension)" Visible="false" />

    <!-- The builder is built first, but its assembly is not referenced by the library: the output item
         gives the path of its built assembly without guessing where the build put it. -->
    <ProjectReference Include="..\DemaConsulting.TextLint.DictionaryBuilder\DemaConsulting.TextLint.DictionaryBuilder.csproj"
                      ReferenceOutputAssembly="false"
                      OutputItemType="DictionaryBuilderAssembly" />

    <!-- The dictionary format source is owned by the builder and compiled into the library too, so the
         program that writes the files and the code that reads them can never disagree on the hash or
         the case fold. -->
    <Compile Include="..\DemaConsulting.TextLint.DictionaryBuilder\DictionaryFormat.cs" Link="Dictionaries\DictionaryFormat.cs" />
  </ItemGroup>

  <!-- The set of word lists is an input too. A deleted file cannot be seen through the file timestamps that the
       incremental target compares, so the list of files is written to a manifest that is an input of the
       conversion: when a list is added, removed, or renamed the manifest changes, becomes newer than the converted
       files, and the conversion runs again. The manifest is rewritten only when its content differs, so an
       unchanged set leaves it (and the conversion) alone. -->
  <Target Name="WriteDictionaryManifest"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <MakeDir Directories="$(DictionaryOutputDir)" />
    <WriteLinesToFile File="$(DictionaryOutputDir)/wordlists.manifest"
                      Lines="@(DictionaryWordList)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />
  </Target>

  <!-- Incremental: the target is skipped when every converted file is newer than every word list, the list of
       word lists, and the builder. A builder error fails the build: its messages are in the compiler error
       format, so MSBuild reports each problem with its file and line, and the non-zero exit code fails the Exec
       task. Design-time builds (an editor or dotnet format loading the project to analyze it) only need the
       source to be analyzed, never the compiled output, and the builder may not have been built yet in
       that configuration, so they skip the conversion. -->
  <Target Name="BuildDictionaries"
          BeforeTargets="CoreCompile;GenerateAssemblyInfo"
          DependsOnTargets="ResolveProjectReferences;WriteDictionaryManifest"
          Condition="'$(DesignTimeBuild)' != 'true'"
          Inputs="@(DictionaryWordList);$(DictionaryOutputDir)/wordlists.manifest;@(DictionaryBuilderAssembly)"
          Outputs="@(DictionaryBinary)">
    <MakeDir Directories="$(DictionaryOutputDir)" />
    <Exec Command="&quot;$(DictionaryDotNet)&quot; &quot;@(DictionaryBuilderAssembly)&quot; --input &quot;$(DictionaryWordListRoot)&quot; --output &quot;$(DictionaryOutputDir)&quot; @(Dictionary, ' ') --technical technical @(DictionaryVariant->'--variants %(Identity)', ' ') --exclusions &quot;$(DictionaryWordListRoot)/exclusions.txt&quot;" />
    <!-- The builder leaves a file whose content did not change untouched, so mark every output as up to date
         to let the next build skip this target. This runs only after the builder succeeded, and Touch fails
         for an output that does not exist (it is never asked to create one), so it cannot hide a failure. -->
    <Touch Files="@(DictionaryBinary)" />
  </Target>

</Project>
